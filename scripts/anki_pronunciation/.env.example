# Capybara pronunciation-deck generator — LOCAL config.
#
# Copy to `scripts/anki_pronunciation/.env` (gitignored) or just export these in your
# shell. Keep them OUT of the repo-root .env: `supabase secrets set --env-file .env`
# uploads every key there to the Supabase project, and the edge function never runs
# this code, so these credentials have no business in the bot's runtime.
#
# The bot's /pronounce command needs none of these — it only emits the phrase list.
#
# Which voice backend synthesizes the reference audio:
#   elevenlabs  a cloned voice (the default)
#   openai      PRESET voices only — OpenAI has no public custom-voice API
#   azure       standard neural or Custom Neural Voice; reuses the AnkiPA account
#   local       real recordings from a folder; no API, no cost, no voiceprint sent out
CAPYBARA_TTS_PROVIDER=elevenlabs

# The voice id/name for the provider above. For ElevenLabs this is the voice_id from
# your voice library; for Azure a name like uk-UA-PolinaNeural; for OpenAI a preset.
CAPYBARA_TTS_VOICE=

# Optional per-provider overrides.
CAPYBARA_TTS_MODEL=
CAPYBARA_TTS_INSTRUCTIONS=

# Provider credentials — only the one matching CAPYBARA_TTS_PROVIDER is needed.
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# provider=local only: folder of recordings plus a manifest.json mapping phrase -> file.
CAPYBARA_RECORDINGS_DIR=
CAPYBARA_RECORDINGS_MANIFEST=
